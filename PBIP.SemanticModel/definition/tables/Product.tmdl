	column 'Price per Kilo' = 1000 * 'Product'[Retail Price] / 'Product'[Weight]
		formatString: #,0.00\ "kr.";-#,0.00\ "kr.";#,0.00\ "kr."
		lineageTag: b5e87fb5-973f-418c-b8f2-12b9566b682d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"da-DK"}

	column PriceCategory# = ```
			
			IF ( 
				'Product'[Price per Kilo] < 650, 
				1, 
				IF ( 
					'Product'[Price per Kilo] < 850, 
					2 ,
					3
				)
			) 
			```
		isHidden
		formatString: 0
