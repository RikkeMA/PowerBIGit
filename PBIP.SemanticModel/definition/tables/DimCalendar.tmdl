	hierarchy Time
		lineageTag: e05b41a5-655c-4b74-8444-4f04fa7b8d20

		level Year
			lineageTag: 51cc5bae-9022-41ec-8d7d-1c3204050978
			column: Year

		level Month
			lineageTag: 4be5a4c4-4e1b-4b9b-964e-fc7527c41890
			column: Month

		level Day
			lineageTag: c5f9411c-411c-4f17-96bf-e388d959ec39
			column: Day

	partition DimCalendar = calculated
		mode: import
		source =
				
				VAR __Yr = YEAR(MAX(Orders[Order Date]))
				VAR __YearsBack = 6
				VAR __Locale = "en-US"
				RETURN
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(__Yr - __YearsBack,1,1),
				        DATE(__Yr,12,31)
				    ),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date],"MMM",__Locale),
				    "MonthNo", MONTH([Date]),
				    "Quarter", FORMAT([Date],"q") & ". qtr.",
				    "QuarterNo",FORMAT([Date],"q"),
				    "Day", DAY([Date]),
				    "Weekday", FORMAT([Date],"ddd", __Locale),
				    "WeekdayNo", WEEKDAY([Date],2), -- Starting day of week = Monday
				    "WeekNumber", WEEKNUM([Date],21) -- ISOWeek number
				)

	annotation PBI_Id = 0d4dd12aebf9440fb4daaa5c3cba1690

